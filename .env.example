# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=5

# Optional External API Keys (OpenAQ API v3)
# Register for free at https://openaq.org to get an API key
OPENAQ_API_KEY=

# In-Memory Cache Configuration
CACHE_TTL_SECONDS=900
MAX_CACHE_SIZE=1000

# CORS Allowed Origins (comma-separated; omit wildcard in production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
